<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Etiquetador.Core</RootNamespace>
    <AssemblyName>Etiquetador.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lectura de PDF (Apache-2.0, sin dependencias nativas). Sustituye a PyMuPDF/pdfplumber de la versión Python. -->
    <PackageReference Include="PdfPig" Version="0.1.17-alpha-202611100027-21de1" />
  </ItemGroup>

</Project>
